# ============================================
# DOCKER ENVIRONMENT CONFIGURATION
# ============================================
# Скопируйте этот файл в .env и заполните значения

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=production

# ============================================
# POSTGRESQL DATABASE
# ============================================
POSTGRES_DB=parsing
POSTGRES_USER=parser
POSTGRES_PASSWORD=parser123
POSTGRES_PORT=5432

# Database URL (автоматически формируется в docker-compose)
# DATABASE_URL=postgresql://parser:parser123@localhost:5432/parsing?schema=public

# ============================================
# REDIS
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ============================================
# API SERVER
# ============================================
PORT=3000
API_URL=http://localhost:3000

# ============================================
# WORKER
# ============================================
WORKER_CONCURRENCY=2

# ============================================
# PARSING SETTINGS
# ============================================
# Максимальное количество страниц для парсинга
MAX_PAGES=10

# Задержка между запросами (мс)
PARSE_DELAY=1500

# ============================================
# PUPPETEER (не менять для Docker)
# ============================================
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
