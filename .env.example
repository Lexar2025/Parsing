# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/vacancy?schema=public"

# ============================================
# API SERVER
# ============================================
# Port for API server
API_PORT=3000

# Host to bind API server
# 0.0.0.0 - accept from any IP
# localhost - only local connections
API_HOST=0.0.0.0

# ============================================
# REDIS (for Worker)
# ============================================
# Redis host
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# ============================================
# WORKER SETTINGS
# ============================================
# Number of concurrent jobs
WORKER_CONCURRENCY=3

# Parse interval in milliseconds
# 21600000 ms = 6 hours
# 3600000 ms = 1 hour
PARSE_INTERVAL=21600000

# Notify interval in milliseconds
# 7200000 ms = 2 hours
# 3600000 ms = 1 hour
NOTIFY_INTERVAL=7200000

# ============================================
# TELEGRAM BOT (optional)
# ============================================
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=

# URL of API server (for bot to call)
# In production: https://yourdomain.com
# In development: http://localhost:3000
API_URL=http://localhost:3000

# ============================================
# ENVIRONMENT
# ============================================
# development | production | test
NODE_ENV=development

# ============================================
# OPTIONAL SETTINGS
# ============================================
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable debug mode
DEBUG=false

# Timezone
TZ=Europe/Chisinau
