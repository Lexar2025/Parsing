# Database
DATABASE_URL="postgresql://postgres:Mancara2004@localhost:5432/vacancy?schema=public"

# API Server
API_PORT=3000
API_HOST=0.0.0.0

# Redis (для BullMQ Worker)
# Установи Redis: https://redis.io/download или через Docker: docker run -d -p 6379:6379 redis:alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Worker настройки
WORKER_CONCURRENCY=3
PARSE_INTERVAL=21600000  # 6 часов в миллисекундах
NOTIFY_INTERVAL=7200000  # 2 часа в миллисекундах

# Telegram Bot (добавишь позже когда создашь бота)
TELEGRAM_BOT_TOKEN=

# Environment
NODE_ENV=development
