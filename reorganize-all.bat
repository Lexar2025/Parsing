@echo off
chcp 65001 >nul
cls
echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║                                                            ║
echo ║     🏗️  ПОЛНАЯ РЕОРГАНИЗАЦИЯ ПРОЕКТА                      ║
echo ║                                                            ║
echo ╚════════════════════════════════════════════════════════════╝
echo.
echo Этот скрипт выполнит:
echo   1. Создание новой структуры папок
echo   2. Перемещение файлов по правильным местам
echo   3. Удаление временных файлов
echo   4. Переименование config -^> settings
echo   5. Автоматическое обновление импортов
echo   6. Пересборку проекта
echo.
echo ⚠️  ВАЖНО: Перед запуском сделай бэкап или git commit!
echo.
set /p confirm="Продолжить? (y/n): "
if /i not "%confirm%"=="y" (
    echo Отменено.
    pause
    exit /b 0
)

echo.
echo ════════════════════════════════════════════════════════════
echo ШАГ 1/3: Реорганизация файлов
echo ════════════════════════════════════════════════════════════
echo.

call reorganize.bat

if errorlevel 1 (
    echo ❌ Ошибка реорганизации!
    pause
    exit /b 1
)

echo.
echo ════════════════════════════════════════════════════════════
echo ШАГ 2/3: Обновление импортов
echo ════════════════════════════════════════════════════════════
echo.

call update-imports.bat

if errorlevel 1 (
    echo ❌ Ошибка обновления импортов!
    pause
    exit /b 1
)

echo.
echo ════════════════════════════════════════════════════════════
echo ШАГ 3/3: Проверка работоспособности
echo ════════════════════════════════════════════════════════════
echo.

echo 🧪 Запуск тестового парсинга...
call npm run parse makler.md Программисты

echo.
echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║                                                            ║
echo ║     ✅ РЕОРГАНИЗАЦИЯ ЗАВЕРШЕНА!                           ║
echo ║                                                            ║
echo ╚════════════════════════════════════════════════════════════╝
echo.
echo 📂 Новая структура:
echo.
echo Parsing/
echo ├── docs/guides/              (вся документация)
echo ├── src/settings/             (настройки)
echo ├── tests/                    (все тесты)
echo ├── data/                     (результаты *.json)
echo ├── cache/                    (кэш)
echo └── scripts/                  (батники)
echo.
echo 📄 Документация:
echo   - REORGANIZE_GUIDE.md       (полная инструкция)
echo   - docs/guides/              (все руководства)
echo   - README.md                 (обновить структуру!)
echo.
echo 🎯 Что дальше:
echo   1. Проверь что парсер работает
echo   2. Обнови README.md с новой структурой
echo   3. Сделай git commit
echo.

pause
